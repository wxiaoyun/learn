{
  "manifest_version": 3,
  "name": "Learning YouTube surface",
  "version": "0.1.0",
  "description": "Plays Quiz plans over YouTube videos.",
  "key": "",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:4517/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Learning logs",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["key-guard.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["katex.min.css", "fonts/*"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
